        let url = "/VirtualizationClient/Paste/?machineName=" + encodeURIComponent(machine.InstanceName) + "&labInstanceKey=" + model.key;
        return $.ajax({
            url: url
            , data: { payload: text }
            , type: "POST"
            , dataType: "json"
            , jsonp: false
        });
    }

    function sendPastedText(text, canUseVmClipboard) {
        if (selectedMachine) {
            if (selectedMachine.window && !selectedMachine.window.closed) {
                selectedMachine.window.labConsole.typeText(text, canUseVmClipboard);
            } else if (selectedMachine?.sshActive) {
                let sshClient = getSshClientInstance("sshClient" + selectedMachine.ProfileId);
                if (sshClient !== null) {
                    if (text === "CTRL-Z") {
                        sshClient.sendCtrlZ();
                    } else if (text === "CTRL-C") {
                        sshClient.sendCtrlZ();
                    } else {
                        sshClient.write(text);
                    }
                }
            } else {
                let remoteController = getSelectedRemoteController();
                if (remoteController != null && remoteController.canSendText && remoteController.canSendText()) {
                    remoteController.sendText(text, canUseVmClipboard);
                } else {
                    const paste = { machine: selectedMachine, request: typeOnHost(selectedMachine, text) };
                    hostPaste = paste;
                    paste.request.always(function () {
                        if (hostPaste === paste) {
                            hostPaste = null;
                        }
                    });
                }
                if (remoteController != null) {
                    remoteController.focus();
                }
            }
        } else if (selectedEndpoint?.ConnectionProtocol == ConnectionProtocol.SSH || selectedEndpoint?.ConnectionProtocol == ConnectionProtocol.Powershell) {
            let sshClient = getSshClientInstance(`sshEndpointClient${selectedEndpoint.Id}`);
            if (sshClient !== null) {
                sshClient.write(text);
            }
        } else if (selectedEndpoint?.ConnectionProtocol == ConnectionProtocol.RDP) {
            let rdpClient = getRdpClientInstance(`rdp-client-endpoint-${selectedEndpoint.Id}`);
            if (rdpClient != null) {
                rdpClient.sendText(text);
            }
        } else if (selectedEndpoint?.ConnectionProtocol == ConnectionProtocol.Telnet) {
            let telnetClient = getTelnetClientInstance(`telnet-client-endpoint-${selectedEndpoint.Id}`);
            if (telnetClient != null) {
                telnetClient.sendText(text);
            }
        } else if (selectedEndpoint?.ConnectionProtocol == ConnectionProtocol.VNC) {
            let vncClient = getVncClientInstance(`vnc-client-endpoint-${selectedEndpoint.Id}`);
            if (vncClient != null) {
                vncClient.sendText(text);
            }
        }
    }

    // Enter goes the way sendPastedText sends text, so it lands after text typed just before it. Each
    // console's own pressEnter waits for any typing that console is still pacing out.
    function pressEnterOnSelectedMachine() {
        if (selectedMachine.window && !selectedMachine.window.closed) {
            selectedMachine.window.labConsole.pressEnter();
        } else if (selectedMachine.sshActive) {
            let sshClient = getSshClientInstance("sshClient" + selectedMachine.ProfileId);
            if (sshClient !== null) {
                sshClient.write("\r");
            }
        } else {
            let remoteController = getSelectedRemoteController();
            const paste = pendingHostPaste(selectedMachine);
            if (remoteController != null && remoteController.canSendText && remoteController.canSendText()) {
                remoteController.pressEnter();
            } else if (paste != null) {
                // The lab host types text the console can't at its own pace, so Enter follows it there
                // once the host has typed the text, and not at all if the text never went in.
                const machine = selectedMachine;
                paste.done(function (typed) {
                    if (typed === true) {
                        typeOnHost(machine, "\n");
                    }
                });
            } else {
                typeOnHost(selectedMachine, "\n");
            }
        }
    }

    // A Telnet endpoint gets no Enter: its console already ends every typed line with one.
    function pressEnterOnEndpoint(endpoint) {
        if (endpoint.ConnectionProtocol === ConnectionProtocol.SSH || endpoint.ConnectionProtocol === ConnectionProtocol.Powershell) {
            let sshClient = getSshClientInstance(`sshEndpointClient${endpoint.Id}`);
            if (sshClient !== null) {
                sshClient.write("\r");
            }
        } else if (endpoint.ConnectionProtocol === ConnectionProtocol.RDP) {
            let rdpClient = getRdpClientInstance(`rdp-client-endpoint-${endpoint.Id}`);
            if (rdpClient !== null) {
                rdpClient.pressEnter();
            }
        } else if (endpoint.ConnectionProtocol === ConnectionProtocol.VNC) {
            let vncClient = getVncClientInstance(`vnc-client-endpoint-${endpoint.Id}`);
            if (vncClient !== null) {
                vncClient.pressEnter();
            }
        }
    }

    // Tells whoever asked for keys or the mouse, through the onSent they gave, whether the input
    // went out.
    function reportSent(onSent, sent) {
        if (typeof onSent === "function") {
            onSent(sent);
        }
    }

    // Input for a console that can't type text, asked for while the lab host types text there,
    // follows that text once the host has typed it. batch holds each item's send, which answers
    // whether the console took it, and its onSent, and may grow until the paste settles. The whole
    // batch is dropped if the text never went in or canTakeAll(its size) says the console has no
    // room for all of it, and an item is dropped on its own if the console refuses it then.
    function sendAfterHostPaste(paste, batch, canTakeAll) {
        paste.done(function (typed) {
            let sending = false;
            try {
                sending = typed === true && canTakeAll(batch.length);
            } catch (e) {
                // A console that throws has no room.
            }
            batch.forEach(function (input) {
                let took = false;
                try {
                    took = sending && input.send() === true;
                } catch (e) {
                    // A console that throws didn't take it.
                }
                if (!took) {
                    reportSent(input.onSent, false);
                }
            });
        }).fail(function () {
            batch.forEach(function (input) { reportSent(input.onSent, false); });
        });
    }

    // Presses waiting on each host paste, batched by the keys a request passes for every one of
    // its presses, so a request is checked for room whole once the paste is done.
    const pressesAfterHostPaste = new WeakMap();

    function pressKeysAfterHostPaste(paste, remoteController, keys, onSent, onStart) {
        let batches = pressesAfterHostPaste.get(paste);
        if (batches === undefined) {
            batches = new Map();
            pressesAfterHostPaste.set(paste, batches);
            paste.always(function () { pressesAfterHostPaste.delete(paste); });
        }
        let batch = batches.get(keys);
        if (batch === undefined) {
            batch = [];
            batches.set(keys, batch);
            sendAfterHostPaste(paste, batch, function (count) { return canControllerTakeInput(remoteController, count); });
        }
        batch.push({ send: function () { return remoteController.pressKeys(keys, onSent, onStart); }, onSent: onSent });
    }

    // Keys go the way Enter does, so they land after text typed just before them. Each returns
    // whether the selected console took the keys; onStart, when given, hears once when they start
    // going out, and onSent once whether they went out.
    function pressKeysOnSelectedMachine(keys, onSent, onStart) {
        if (selectedMachine.window && !selectedMachine.window.closed) {
            return selectedMachine.window.labConsole.pressKeys(keys, onSent, onStart);
        }
        if (selectedMachine.sshActive) {
            return writeKeysInTerminal(getSshClientInstance("sshClient" + selectedMachine.ProfileId), keys, onSent, onStart);
        }
        const remoteController = getSelectedRemoteController();
        if (remoteController == null || typeof remoteController.pressKeys !== "function") {
            return false;
        }
        const paste = pendingHostPaste(selectedMachine);
        if (!(remoteController.canSendText && remoteController.canSendText()) && paste != null) {
            // Text this console can't type goes through the lab host, so keys follow it there.
            pressKeysAfterHostPaste(paste, remoteController, keys, onSent, onStart);
            return true;
        }
        return remoteController.pressKeys(keys, onSent, onStart);
    }

    function pressKeysOnEndpoint(endpoint, keys, onSent, onStart) {
        if (endpoint.ConnectionProtocol === ConnectionProtocol.SSH || endpoint.ConnectionProtocol === ConnectionProtocol.Powershell) {
            return writeKeysInTerminal(getSshClientInstance(`sshEndpointClient${endpoint.Id}`), keys, onSent, onStart);
        }
        if (endpoint.ConnectionProtocol === ConnectionProtocol.RDP) {
            const rdpClient = getRdpClientInstance(`rdp-client-endpoint-${endpoint.Id}`);
            return rdpClient !== null && rdpClient.pressKeys(keys, onSent, onStart);
        }
        if (endpoint.ConnectionProtocol === ConnectionProtocol.VNC) {
            const vncClient = getVncClientInstance(`vnc-client-endpoint-${endpoint.Id}`);
            return vncClient !== null && vncClient.pressKeys(keys, onSent, onStart);
        }
        return false;
    }

    // Whether a console that queues the mentor's input would take count more of it. One that can't
    // say, such as a terminal, which sends at once, or one waiting on the lab host's paste, answers
    // true and leaves each press to be refused on its own.
    function canControllerTakeInput(controller, count) {
        return controller == null || typeof controller.canTakeInput !== "function" || controller.canTakeInput(count) !== false;
    }

    function canSelectedMachineTakeInput(count) {
        if (selectedMachine.window && !selectedMachine.window.closed) {
            return canControllerTakeInput(selectedMachine.window.labConsole, count);
        }
        if (selectedMachine.sshActive) {
            return true;
        }
        const remoteController = getSelectedRemoteController();
        if (remoteController != null && !(remoteController.canSendText && remoteController.canSendText()) && pendingHostPaste(selectedMachine) != null) {
            return true;
        }
        return canControllerTakeInput(remoteController, count);
    }

    // How long the pastes and typed text still going into a console can hold up the input asked
    // for after them, or 0 for a console that doesn't queue them.
    function pacedTimeAheadIn(controller) {
        return controller != null && typeof controller.pacedTimeAhead === "function" ? controller.pacedTimeAhead() : 0;
    }

    function canEndpointTakeInput(endpoint, count) {
        if (endpoint.ConnectionProtocol === ConnectionProtocol.RDP) {
            return canControllerTakeInput(getRdpClientInstance(`rdp-client-endpoint-${endpoint.Id}`), count);
        }
        if (endpoint.ConnectionProtocol === ConnectionProtocol.VNC) {
            return canControllerTakeInput(getVncClientInstance(`vnc-client-endpoint-${endpoint.Id}`), count);
        }
        return true;
    }

    // The mouse goes the way keys do, so it lands after text typed just before it. Only Spark
    // consoles take it.
    function useMouseOnSelectedMachine(gesture, onSent, onStart) {
        if (selectedMachine.sshActive) {
            return false;
        }
        const remoteController = getSelectedRemoteController();
        if (remoteController == null || typeof remoteController.useMouse !== "function") {
            return false;
        }
        const sized = withScreen(gesture);
        const paste = pendingHostPaste(selectedMachine);
        if (!(remoteController.canSendText && remoteController.canSendText()) && paste != null) {
            sendAfterHostPaste(paste, [{ send: function () { return remoteController.useMouse(sized, onSent, onStart); }, onSent: onSent }], function () { return true; });
            return true;
        }
        return remoteController.useMouse(sized, onSent, onStart);
    }

    function useMouseOnEndpoint(endpoint, gesture, onSent, onStart) {
        if (endpoint.ConnectionProtocol === ConnectionProtocol.RDP) {
            const rdpClient = getRdpClientInstance(`rdp-client-endpoint-${endpoint.Id}`);
            return rdpClient !== null && typeof rdpClient.useMouse === "function" && rdpClient.useMouse(withScreen(gesture), onSent, onStart);
        }
        if (endpoint.ConnectionProtocol === ConnectionProtocol.VNC) {
            const vncClient = getVncClientInstance(`vnc-client-endpoint-${endpoint.Id}`);
            return vncClient !== null && typeof vncClient.useMouse === "function" && vncClient.useMouse(withScreen(gesture), onSent, onStart);
        }
        return false;
    }

    // The gesture with the size of the selected console's screen, which its spots were picked on,
    // so the console drops it if the screen changes size while it waits its turn.
    function withScreen(gesture) {
        const canvas = selectedScreenCanvas();
        if (canvas === null || gesture.screen !== undefined) {
            return gesture;
        }
        return Object.assign({}, gesture, { screen: { width: canvas.width, height: canvas.height } });
    }

    // Shows the student where the mentor clicked: a ripple on each press, and at both ends of a drag.
    const REPEAT_CLICK_RIPPLE_DELAY_MS = 150;
    const DRAG_END_RIPPLE_DELAY_MS = 300;
    const CLICK_PRESSES = { double_click: 2, triple_click: 3 };
    function showMouseRipples(gesture) {
        const overlay = window.mentorEnvironmentOverlay;
        const canvas = selectedScreenCanvas();
        if (!overlay || canvas === null || gesture.action === "move" || gesture.action === "scroll") {
            return;
        }
        overlay.ripple(canvas, gesture.x, gesture.y);
        const presses = CLICK_PRESSES[gesture.action] || 1;
        for (let press = 1; press < presses; press++) {
            window.setTimeout(function () { overlay.ripple(canvas, gesture.x, gesture.y); }, press * REPEAT_CLICK_RIPPLE_DELAY_MS);
        }
        if (gesture.action === "drag") {
            window.setTimeout(function () { overlay.ripple(canvas, gesture.toX, gesture.toY); }, DRAG_END_RIPPLE_DELAY_MS);
        }
    }

    // The canvas the selected console draws the VM's screen on, or null when it has none, such as a
    // terminal, or isn't connected.
    function selectedScreenCanvas() {
        const screen = getScreenDataUrl();
        return screen?.ok === true && screen.canvas ? screen.canvas : null;
    }

    // How many times the student has used the screen in view, by their own mouse, keys or touch.
    // A spot picked on a screenshot taken before the latest of them may no longer be where it was.
    let studentInputCount = 0;
    if (typeof window.mentorEnvironmentOverlay?.watchStudentInput === "function") {
        window.mentorEnvironmentOverlay.watchStudentInput(selectedScreenCanvas, function () { studentInputCount++; });
    }

    // Which console's screen is showing, its size in remote pixels, and how many times the student
    // has used it. A spot the lab client API's caller picked on a screenshot holds only while this
    // is unchanged.
    function getScreenFrame() {
        const canvas = selectedScreenCanvas();
        if (canvas === null) {
            return null;
        }
        const consoleId = selectedMachine ? `machine:${selectedMachine.ProfileId}` : `endpoint:${selectedEndpoint.Id}`;
        return { consoleId: consoleId, width: canvas.width, height: canvas.height, studentInputCount: studentInputCount };
    }

    // The screen in the latest screenshot a lab client API caller took, which a changes wait
    // measures from when it shows the same console.
    let seenScreen = null;

    // Ends each wait handed to the selected machine's pop-out, see labConsole.waitForScreen.
    const delegatedWaitEnds = new Set();

    // Clears the mentor's bubble here and in the selected machine's pop-out, which shows it there.
    function clearMentorOverlay(reason) {
        selectedMachineChildLabConsole()?.clearMentorOverlay(reason);
        window.mentorEnvironmentOverlay?.clear(reason);
    }

    // The selected console is being left or has gone away: the student is switching off it, its
    // pop-out has closed, or it has disconnected. The mentor's bubble goes, and a wait on a
    // pop-out's screen ends, wherever they were.
    function leaveConsole() {
        clearMentorOverlay("console_changed");
        delegatedWaitEnds.forEach(function (end) { end(); });
    }

    function writeKeysInTerminal(sshClient, keys, onSent, onStart) {
        const sequence = terminalSequence(keys);
        if (sshClient === null || sequence === null) {
            return false;
        }
        if (typeof onStart === "function") {
            try {
                onStart();
            } catch (e) {
                // Whoever listens failing doesn't stop the keys going out.
            }
        }
        sshClient.write(sequence);
        reportSent(onSent, true);
        return true;
    }

    // What a terminal reads for a key on its own, by DOM key code.
    const TERMINAL_KEY_SEQUENCES = {
        8: "\x7f", 9: "\t", 13: "\r", 27: "\x1b", 32: " ",
        33: "\x1b[5~", 34: "\x1b[6~", 35: "\x1b[F", 36: "\x1b[H",
        37: "\x1b[D", 38: "\x1b[A", 39: "\x1b[C", 40: "\x1b[B", 45: "\x1b[2~", 46: "\x1b[3~",
        112: "\x1bOP", 113: "\x1bOQ", 114: "\x1bOR", 115: "\x1bOS", 116: "\x1b[15~", 117: "\x1b[17~",
        118: "\x1b[18~", 119: "\x1b[19~", 120: "\x1b[20~", 121: "\x1b[21~", 122: "\x1b[23~", 123: "\x1b[24~"
    };

    // The characters a terminal reads for a key combination: Ctrl with a letter is its control
    // character, Alt prefixes Esc, Shift capitalizes a letter or reverses Tab. Null for a combination
    // a terminal has no characters for, such as anything with the Windows key.
    function terminalSequence(keys) {
        const ctrl = keys.includes(17);
        const alt = keys.includes(18);
        const shift = keys.includes(16);
        const others = keys.filter(function (key) { return key !== 16 && key !== 17 && key !== 18; });
        if (others.length !== 1) {
            return null;
        }
        const key = others[0];
        let sequence = null;
        if (key >= 65 && key <= 90) {
            sequence = ctrl ? String.fromCharCode(key - 64) : String.fromCharCode(shift ? key : key + 32);
        } else if (key === 9 && shift && !ctrl) {
            sequence = "\x1b[Z";
        } else if (!ctrl && !shift && key >= 48 && key <= 57) {
            sequence = String.fromCharCode(key);
        } else if (!ctrl && !shift && TERMINAL_KEY_SEQUENCES[key] !== undefined) {
            sequence = TERMINAL_KEY_SEQUENCES[key];
        }
        return sequence !== null && alt ? "\x1b" + sequence : sequence;
    }

    function sendTextToEndpoint(endpoint, text) {
        if (endpoint.ConnectionProtocol === ConnectionProtocol.SSH || endpoint.ConnectionProtocol === ConnectionProtocol.Powershell) {
            writeTextInSshEndpoint(endpoint, text);
        } else if (endpoint.ConnectionProtocol === ConnectionProtocol.RDP) {
            sendTextToRdpEndpoint(endpoint, text);
        } else if (endpoint.ConnectionProtocol === ConnectionProtocol.Telnet) {
            sendTextToTelnetEndpoint(endpoint, text);
        } else if (endpoint.ConnectionProtocol === ConnectionProtocol.VNC) {
            sendTextToVncEndpoint(endpoint, text);
        }
    }
    function writeTextInSshEndpoint(endpoint, text) {
        let sshClient = getSshClientInstance(`sshEndpointClient${endpoint.Id}`);
        if (sshClient !== null) {
            if (text === "CTRL-Z") {
                sshClient.sendCtrlZ();
            } else if (text === "CTRL-C") {
                sshClient.sendCtrlZ();
            } else {
                // A line break goes out as the carriage return a terminal's Enter key sends. A bare
                // line feed is a different key to some shells: PowerShell on Windows takes it as
                // Ctrl+Enter and inserts a line instead of running the command.
                sshClient.write(text.replace(/\r?\n/g, "\r"));
            }
        }
    }

    function sendTextToRdpEndpoint(endpoint, text) {
        let rdpClient = getRdpClientInstance(`rdp-client-endpoint-${endpoint.Id}`);
        if (rdpClient !== null) {
            rdpClient.sendText(text);
        }
    }

    // Spark consoles type the text as queued input, see typeKeys; every other console takes it the
    // way typeText sends it.
    function typeKeysOnSelectedMachine(text, options) {
        if (selectedMachine.window && !selectedMachine.window.closed) {
            selectedMachine.window.labConsole?.typeKeys(text, options);
            return;
        }
        const remoteController = selectedMachine.sshActive ? null : getSelectedRemoteController();
        if (remoteController != null && typeof remoteController.typeKeys === "function" && remoteController.canSendText && remoteController.canSendText()) {
            remoteController.typeKeys(text, options);
            remoteController.focus();
        } else {
            sendPastedText(text);
        }
    }

    // An RDP endpoint's Spark console types the text as queued input, see typeKeys; every other
    // endpoint takes it the way typeText sends it.
    function typeKeysOnEndpoint(endpoint, text, options) {
        if (endpoint.ConnectionProtocol === ConnectionProtocol.RDP) {
            const rdpClient = getRdpClientInstance(`rdp-client-endpoint-${endpoint.Id}`);
            if (rdpClient !== null) {
                rdpClient.typeKeys(text, options);
            }
        } else {
            sendTextToEndpoint(endpoint, text);
        }
    }

    function sendTextToTelnetEndpoint(endpoint, text) {
        let telnetClient = getTelnetClientInstance(`telnet-client-endpoint-${endpoint.Id}`);
        if (telnetClient !== null) {
            telnetClient.writeLine(text);
        }
    }

    function sendTextToVncEndpoint(endpoint, text) {
        let vncClient = getVncClientInstance(`vnc-client-endpoint-${endpoint.Id}`);
        if (vncClient !== null) {
            vncClient.sendText(text);
        }
    }

    // wrapScreenData adapts whatever a controller returns into the dispatcher's
    // response shape so every dispatcher branch uses the same syntax.
    //
    // Accepted inputs:
    //   null/undefined           → controller absent or signaled unavailable
    //   HTMLCanvasElement        → controller returns its source canvas directly
    //                              (VM controllers — RDP/VNC/Spark/etc.)
    //   { ok, canvas, reason }   → controller returns the shaped result directly
    //                              (terminal controllers — ssh-client, container)
    //   Promise<{ ok, canvas, reason }>
    //                            → async controllers must resolve to the dispatcher
    //                              response shape; the promise is passed through and
    //                              awaited at the lab-client-api.js boundary
    //
    // Dispatcher response shape:
    //   { ok: true,  canvas: HTMLCanvasElement, reason: null }
    //   { ok: false, canvas: null, reason: "not_supported" }   active target type cannot produce screen data
    //   { ok: false, canvas: null, reason: "not_available" }   target supports it but cannot produce data right now
    //
    // PNG encoding happens at the lab-client-api.js boundary (getEnvironmentScreenDataUrl)
    // and inside the lab-client-wrapper composite (canvas.toDataURL on the composite
    // output). The canvas is reused as a drawImage source in the composite without
    // a round-trip through base64.
    function wrapScreenData(input) {
        if (input == null) return { ok: false, canvas: null, reason: "not_available" };
        // Duck-type rather than `instanceof HTMLCanvasElement`: a canvas
        // created in a pop-out window's document is rooted in that window's
        // realm and fails the wrapper's instanceof check, even though it's a
        // perfectly usable canvas. Structural detection works across realms.
        if (typeof input.toDataURL === "function" && typeof input.getContext === "function") {
            return { ok: true, canvas: input, reason: null };
        }
        return input;
    }

    // Returns the labConsole of the selected machine's pop-out window, or null
    // if no such window or it cannot currently be reached. Cross-frame access
    // throws during teardown / document replacement; treat that as transient
    // unavailability rather than a hard error.
    function selectedMachineChildLabConsole() {
        if (!selectedMachine?.window || selectedMachine.window.closed) return null;
        try {
            return selectedMachine.window.labConsole ?? null;
        } catch {
            return null;
        }
    }

    // Returns the SshClient instance backing an in-VM SSH session on the
    // selected machine, or null if no SSH session is active.
    function selectedMachineSshClient() {
        if (!selectedMachine?.sshActive) return null;
        return getSshClientInstance("sshClient" + selectedMachine.ProfileId);
    }

    // Resolves which controller-like object should answer screenshot requests
    // for the currently selected machine. Order matters: a pop-out window owns
    // its own labConsole; otherwise an in-VM SSH session takes precedence over
    // the underlying remote controller.
    function resolveSelectedMachineScreenController() {
        return selectedMachineChildLabConsole()
            ?? selectedMachineSshClient()
            ?? getSelectedRemoteController();
    }

    // Endpoint protocol → factory yielding the controller instance that
    // answers screenshot requests for that endpoint type. Adding a new
    // endpoint protocol is a one-line entry here.
    const ENDPOINT_SCREEN_CONTROLLERS = {
        [ConnectionProtocol.SSH]:        ep => getSshClientInstance(`sshEndpointClient${ep.Id}`),
        [ConnectionProtocol.Powershell]: ep => getSshClientInstance(`sshEndpointClient${ep.Id}`),
        [ConnectionProtocol.RDP]:        ep => getRdpClientInstance(`rdp-client-endpoint-${ep.Id}`),
        [ConnectionProtocol.Telnet]:     ep => getTelnetClientInstance(`telnet-client-endpoint-${ep.Id}`),
        [ConnectionProtocol.VNC]:        ep => getVncClientInstance(`vnc-client-endpoint-${ep.Id}`),
    };

    function getScreenDataUrl() {
        if (selectedMachine) {
            return wrapScreenData(resolveSelectedMachineScreenController()?.getScreenDataUrl());
        }
        if (selectedEndpoint) {
            const resolver = ENDPOINT_SCREEN_CONTROLLERS[selectedEndpoint.ConnectionProtocol];
            if (!resolver) {
                // Selected endpoint with an unrecognized ConnectionProtocol.
                return { ok: false, canvas: null, reason: "not_supported" };
            }
            return wrapScreenData(resolver(selectedEndpoint)?.getScreenDataUrl());
        }
        return { ok: false, canvas: null, reason: "not_available" };
    }

    function executeCommandOnSelectedMachine(commandText, options) {
        $.ajax({
            url: "/VirtualizationClient/ExecuteMachineCommand/" + model.labInstanceId,
            type: "POST",
            dataType: 'json',
            data: { machineId: selectedMachine.ProfileId, commandText: commandText, options: options },
            cache: false
        }).always(function (response) {
            if (response && response.Success) {
                let remoteController = getSelectedRemoteController();
                if (remoteController != null) {
                    remoteController.focus();
                }
            } else {
                alert(response && response.Error ? response.Error : "Sorry an error occurred");
            }
        });
    }

    // `$select` is the drive's dropdown, when the action came from one. Passing it makes the
    // action own the dropdown for its duration: disabled while in flight, moved to the new
    // value only once the host has accepted it, and put back otherwise. Without that the
    // select keeps whatever the user picked even when the drive rejected it, so the lab shows
    // media that was never loaded — worse than the silence, because it reads as success.
    function doMediaAction(url, onSuccess, onError, $select) {
        if (model.contentOnly) { return; }
        // What the drive is actually loaded with. The select has already moved to the new
        // value by the time `change` fires, so it cannot be read back off the element.
        var previousValue = $select ? $select.data("loadedValue") : null;
        $("#quickMessage").html(Text.Loading);
        // Serializing per select keeps `loadedValue` meaningful: overlapping requests could
        // revert to media a later, successful load had already moved past.
        if ($select) { $select.prop("disabled", true); }
        ajaxPost(url, function (response) {
            if ($select) { $select.prop("disabled", false); }
            $("#quickMessage").html("");
            if (response.Success) {
                if ($select) { rememberLoadedMedia($select); }
                if (onSuccess) { onSuccess(); }
            } else {
                if ($select) { $select.val(previousValue); }
                if (onError) { onError(response); } else { showMediaActionError(response); }
            }
        },
            function () {
                if ($select) {
                    $select.prop("disabled", false);
                    $select.val(previousValue);
                }
                $("#quickMessage").html("");
                if (onError) { onError(); } else { showMediaActionError(); }
            }
        );
    }

    function rememberLoadedMedia($select) {
