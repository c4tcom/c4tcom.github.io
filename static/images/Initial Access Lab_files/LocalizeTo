            // The value the adapter is actually connected to, to fall back on if the host
            // refuses or the request fails. The select has already moved to the new value by
            // the time change fires, so it can't be read back from the element.
            const previousValue = $select.data("connectedValue");
            let url = "/VirtualizationClient/ConnectNetwork/" + model.labInstanceId + "/?machineId=" + machineId + "&adapterId=" + networkAdapterId;
            if (this.value > 0) {
                url += "&networkId=" + this.value;
