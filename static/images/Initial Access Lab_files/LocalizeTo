    function getShownVirtualMachineEndpointById(id) {
        for (let machine of labData.Machines) {
            for (let endpoint of machine.Endpoints.filter(isEndpointShown)) {
                if (endpoint.Id == id) {
                    return endpoint;
                }
            }
        }
        return null;
    }

    // The console receives every endpoint (the mentor reads them all), but shows only those the
    // viewer can see. Endpoints hidden from students show to admins only when they are visible to
    // admins. VirtualizationClientController.IsEndpointShown applies the same rule.
    function isEndpointShown(endpoint) {
        return endpoint.IsStudentVisible || (labData.ShowHiddenMachines && endpoint.IsAdminVisible);
    }

    function getFirstVirtualMachineEndpoint() {
        for (let machine of labData.Machines) {
            for (let endpoint of machine.Endpoints.filter(isEndpointShown)) {
                return endpoint;
            }
        }
        return null;
    }

    // A click on the mentor's bubble over the console, such as a tour's Back or Next, which keeps
    // the keyboard on the bubble. The path is taken when the click began, so it holds even once the
    // click has replaced or removed the bubble.
    function isInMentorOverlay(event) {
        const original = event.originalEvent;
        const path = original && typeof original.composedPath === "function" ? original.composedPath() : [event.target];
        return path.some(function (element) { return element instanceof Element && element.classList.contains("mentor-environment-layer"); });
    }

    function getSelectionText() {
        if (window.getSelection) {
            return window.getSelection().toString();
        } else if (document.selection && document.selection.type != "Control") {
            return document.selection.createRange().text;
        }
        return false;
    }

    function showInitialDialog() {
        var dialogs = [];
        var dialogWidth = 700;
        var dialogHeight = 550;
        var dialogIndex = -1;
        var moveNext = function () {
            dialogIndex++;
            if (dialogs.length > dialogIndex) {
                if (dialogIndex >= 1) {
                    dialogWidth = $("#modalDialog").dialog("option", "width");
                    dialogHeight = $("#modalDialog").dialog("option", "height");
                }
                dialogs[dialogIndex]();
            } else {
                closeDialog();
                initialDialogIsVisible = false;
            }
        };
        var movePrevious = function () {
            dialogWidth = $("#modalDialog").dialog("option", "width");
            dialogHeight = $("#modalDialog").dialog("option", "height");
            dialogIndex--;
            if (dialogIndex >= 0) {
                dialogs[dialogIndex]();
            }
        };
        var getButtons = function () {
            var buttons = [];
            if (dialogIndex > 0) {
                buttons.push({
                    text: "< Previous",
                    width: 100,
                    click: movePrevious
                });
            }
            if (dialogIndex >= dialogs.length - 1) {
                buttons.push({
                    text: "OK",
                    width: 100,
                    click: moveNext
                });
            } else {
                buttons.push({
                    text: "Next >",
                    width: 100,
                    click: moveNext
                });
            }
            return buttons;
        };
        moveNext();
    }

    function selectEndpointById(id) {
        const endpoint = getShownVirtualMachineEndpointById(id);
        if (endpoint) {
            selectEndpoint(endpoint);
        }
    }
    function selectMachineById(id, notifyServer, expandInfo) {
        let machines = labData.Machines;
        let numMachines = machines.length;
        for (let i = 0; i < numMachines; i++) {
            let machine = machines[i];
            if (machine.ProfileId === id) {
                selectMachine(machine, notifyServer, expandInfo);
                return true;
            }
        }
        return false;
    }

    var remoteControllerDisconnectedCount = 0;

    function expandMachineInfoPanel($machine) {
        $machine.find(".machineNameCenter").attr("aria-expanded", "true");
        $machine.find(".machineInfo").slideDown(300, function () {
            if (model.layoutVersion === 1) {
                $("#navigationBarScrollable").mCustomScrollbar("update");
            }
        });
    }

    function selectMachine(machine, notifyServer, expandInfo) {
        if (machine === selectedMachine) {
            // Reselecting the already-active machine (e.g. a header click on a
            // single-machine lab, which auto-selects its only machine on load)
            // is otherwise a no-op — that leaves no way to ever reveal the
            // detail panel/Ctrl+Alt+Delete for that common case. Toggle it
            // instead of falling through to the reconnect/notify-server logic
            // below, which reselection doesn't need.
            if (expandInfo) {
                let $machines = model.isChildClient
                    ? window.parent.getResourcesExtensionsPlaceHolder()
                    : $("#machines");
                let $machine = $machines.find("#machine" + machine.ProfileId);
                if ($machine.find(".machineNameCenter").attr("aria-expanded") === "true") {
                    $machine.find(".machineNameCenter").attr("aria-expanded", "false");
                    $machine.find(".machineInfo").slideUp(300);
                } else {
                    expandMachineInfoPanel($machine);
                }
            }
            return;
        }
        leaveConsole();
        $contentResourceWrapper.hide();
        let $machines = model.isChildClient
            ? window.parent.getResourcesExtensionsPlaceHolder()
            : $("#machines");
        if (selectedMachine) {
            $machines.find("#machine" + selectedMachine.ProfileId).find(".machineInfo").slideUp(300);
        }
        if (selectedEndpoint) {
            $machines.find(".endpoint.selected .expanded-info").slideUp("fast");
        }

        $machines.find(".machine").removeClass("selected").find(".machineNameCenter").attr("aria-expanded", "false");
        $machines.find(".endpoint").removeClass("selected").find(".name").attr("aria-expanded", "false");
        let $machine = $machines.find("#machine" + machine.ProfileId);
        $machine.addClass("selected");
        if (model.useTabbedInterface) {
            tabList.setActiveTabById(machine.ProfileId);
        }
        // Wiring a machine to the console (lab load, monitor/mentor sync, a
        // snapshot revert) isn't the same as the user asking to see this card's
        // detail panel in the Resources tab. Only expand — and only then put
        // Ctrl+Alt+Delete and the rest of the panel's controls in the tab order
        // — when a direct header click/keypress asked for it.
        if (expandInfo) {
            expandMachineInfoPanel($machine);
        }
        $("#machineSelectMenu .menuItem").removeClass("selected");
        let $machineSelectHtml = $("#machineSelect" + machine.ProfileId);
        $machineSelectHtml.addClass("selected");
        selectedMachine = machine;
        selectedContentResource = null;
        selectedEndpoint = null;
        labData.SelectedVirtualMachineEndpointId = null;
        remoteControllerDisconnectedCount = 0;

        // Tell the api a machine is now the active target. Fires on the initial
        // auto-select during lab init and on every subsequent user-initiated
        // change. Mentor and other selection-aware consumers subscribe via
        // api.v1.onEnvironmentSelectionChanged.
        if (typeof api !== 'undefined' && typeof api.machineSelected === 'function') {
            api.machineSelected(machine.ProfileId);
        }
        $("#machineName").html(machine.DisplayName);
        if (selectedMachineHistory.indexOf(machine.ProfileId) == -1) {
            selectedMachineHistory.push(machine.ProfileId);
        }
        if (notifyServer) {
            ajaxPost(
                "/VirtualizationClient/MarkSelectedMachine/" + model.labInstanceId + "/?machineId=" + machine.ProfileId,
                function (response) {
                    selectedMachineState = response.State;
                    connectToSelectedMachine();
                }
            );
        } else if (selectedMachineState === 0) {
            setupVmVisibility();
        } else {
            connectToSelectedMachine();
        }
    }

    // Shows the xterm.js terminal for the selected machine and (re)connects it. Shared by the two
    // terminal console types: the SSH-to-guest terminal (in-guest sshd) and the KVM serial console
    // (host-side virsh console over WebSSH). They render identically and occupy the same terminal
    // slot ("sshClient"+ProfileId / sshActive); only the connect-info source differs, selected by
    // the serialConsole flag, which ssh-client.js maps to the serial-console endpoint.
    function showSshTerminalForSelectedMachine(serialConsole) {
        $rdpWrapper.hide();
        $sshWrapper.show();
        $httpEndpointWrapper.hide();
        $rdpEndpointWrapper.hide();
        $telnetEndpointWrapper.hide();
        $vncEndpointWrapper.hide();
        $contentResourceWrapper.hide();
        selectedMachine.sshActive = true;
        let sshClientElementId = "sshClient" + selectedMachine.ProfileId;
        for (let sshClientInstance of _sshClientInstances) {
            if (sshClientInstance.terminalElementId !== sshClientElementId) {
                sshClientInstance.hide();
            }
        }

        let existingSshClient = getSshClientInstance(sshClientElementId);
        if (existingSshClient !== null) {
            existingSshClient.show();
            existingSshClient.connect();
        } else {
            let sshStatusElementId = "sshStatus" + selectedMachine.ProfileId;
            $sshWrapper.append("<div class='sshContainer'><div class='sshClientStatus' id='" + sshStatusElementId + "'></div><div class='sshClient' id='" + sshClientElementId + "'></div></div>");
            let sshConnectionInfo = {
                labInstanceKey: model.key,
                machineId: selectedMachine.ProfileId,
                terminalElementId: sshClientElementId,
                statusElementId: sshStatusElementId,
                serialConsole: serialConsole
            };
            if (serialConsole) {
                // KVM serial console attaches to the VM's getty, so the terminal client can auto-log-in
                // with the VM's own credentials (the same ones shown in the Resources panel). When
                // absent, ssh-client.js just presents a clean login prompt for manual entry.
                sshConnectionInfo.username = selectedMachine.Username;
                sshConnectionInfo.password = selectedMachine.Password;
            }
            let sshClient = new SshClient(sshConnectionInfo);
            sshClient.connect();
        }
    }

    function connectToSelectedMachine() {
        setupVmVisibility();
        if (selectedMachine.window && !selectedMachine.window.closed) {
            selectedMachine.window.focus();
            return;
        }
        if (selectedMachine.ConnectViaRdp) {
            $sshWrapper.hide();
            $httpEndpointWrapper.hide();
            $rdpEndpointWrapper.hide();
            $telnetEndpointWrapper.hide();
            $vncEndpointWrapper.hide();
            $contentResourceWrapper.hide();
            $("#rdpUsername").html(selectedMachine.Username);
            $("#rdpPassword").html(selectedMachine.Password);
            $vmWrapper.hide();
            let remoteController = getSelectedRemoteController();
            if (remoteController != null) {
                remoteController.disconnect();
            }
            if (selectedMachineState !== 0) {
                $rdpWrapper.show();
            }
            return;
        }

        // KVM serial console: the VM's live console is a text terminal served from the hypervisor
        // host (virsh console) over WebSSH — checked before UseSshTerminal so a KVM serial VM never
        // falls through to the guest-SSH path. UseSerialConsole is server-computed (KVM fabric +
        // AllowSshConnections), so non-KVM VMs never enter here.
        if (selectedMachine.UseSerialConsole) {
            showSshTerminalForSelectedMachine(true);
            return;
        }

        // SSH-to-guest terminal (in-guest sshd) — distinct feature from the KVM serial console
        // above. Excludes platformId 10/11 (Azure/AWS) which use the Spark SSH client instead.
        if (selectedMachine.UseSshTerminal && (model.platformId != 10 && model.platformId != 11)) {
            showSshTerminalForSelectedMachine(false);
            return;
        }

        $vmWrapper.show();
        $sshWrapper.hide();
        $httpEndpointWrapper.hide();
        $rdpEndpointWrapper.hide();
        $telnetEndpointWrapper.hide();
        $vncEndpointWrapper.hide();
        $rdpWrapper.hide();
        $contentResourceWrapper.hide();

        for (let remoteController of _remoteControllers) {
            if (remoteController.machineId == selectedMachine.ProfileId) {
                if (selectedMachineState !== 0) {
                    if (model.isMonitor && model.enableRdpSessionShadowing && !selectedMachine.RdpSessionId) {
                        getMachineRdpSessionId(selectedMachine, function () {
                            connectSelectedRemoteController();
                        });
                    } else {
                        connectSelectedRemoteController();
                    }
                } else {
                    remoteController.disconnect();
                }
            } else {
                // Deselected controllers are torn down — unless they have an active enhanced/RDP
                // session, or opt into staying connected while hidden (KVM VNC, which tolerates
                // close/reopen poorly, so it persists and a switch-back is just show()). The
                // optional call leaves controllers without the capability unaffected.
                const keepConnected =
                    (remoteController.supportsEsmOrRdp && remoteController.connectedToEnhancedSessionOrRdp())
                    || remoteController.staysConnectedWhileHidden?.();
                if (!keepConnected) {
                    remoteController.disconnect();
                }
                remoteController.hide();
            }
        }
    }

